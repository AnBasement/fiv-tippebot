# Kopier denne filen til .env og fyll inn ekte verdier lokalt.
# .env skal ALDRI committes - den ligger allerede i .gitignore.
# På Render settes disse i stedet under Environment / Secret Files.

# === Discord ===
# Bot-tokenet fra Discord Developer Portal.
DISCORD_TOKEN=

# Kommaseparert liste med Discord bruker-IDer som har admin-tilgang
# (brukes bl.a. av !ppr og for å styre hvem som kan bruke admin-only kommandoer).
ADMIN_IDS=123456789012345678,987654321098765432

# === Google Sheets ===
# Sti til service account-nøkkelfilen (se credentials.json).
GOOGLE_SHEETS_KEYFILE=credentials.json

# Navn på Google Sheets-dokumentene. Standardverdiene i data/config.py
# matcher de ekte dokumentene - sett disse kun for å peke mot en testkopi
# (f.eks. ved testing av en gspread-oppgradering).
# VESTSK_TIPPING_SHEET_NAME=Vestsk Tipping
# FEST_I_VEST_SHEET_NAME=Fest i Vest

# === ESPN Fantasy API ===
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
ESPN_S2=
ESPN_SWID=

# === PPR ===
# Kommaseparert liste over spillernavn som skal telle med i PPR-rangeringen
# (må matche fane-navnene i Fest i Vest-arket). Oppdater ved endring i ligaens
# deltakere mellom sesonger.
# PPR_PLAYER_NAMES=Kristoffer,Arild,Knut,Einar,Torstein,Peter,Edvard H,Tor

# === Andre filer botten trenger (ikke miljøvariabler, men egne hemmelige filer) ===
# credentials.json  - Google service account-nøkkel, se GOOGLE_SHEETS_KEYFILE over
# discord_ids.json  - mapping fra ESPN lag-ID til Discord bruker-ID, format:
#                      {"espn_team_id": "discord_user_id", ...}
#
# Kanal-IDer (PREIK_KANAL, VESTSK_KANAL, ADMIN_CHANNEL_ID) er per nå vanlige
# konstanter i data/channel_ids.py, ikke miljøvariabler - siden botten kun
# kjører mot én, spesifikk server er det ingen praktisk fordel akkurat nå.
